# Copy this file to .env.local and fill in the values yourself.
# Never commit .env.local.

# Gemini (main AI provider)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, comma separated, tried in order
GEMINI_MODELS=

# Groq (backup, used only when every Gemini model fails)
GROQ_API_KEY=
# Optional, comma separated, tried in order
GROQ_MODELS=

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# demo or local
APP_ENV=demo

# Demo only. "true" shows the quick login buttons on a hosted demo (they always show on localhost).
# Needs DEMO_QUICK_LOGIN_PASSWORD too. Remove both before real use.
DEMO_QUICK_LOGIN=
DEMO_QUICK_LOGIN_PASSWORD=
